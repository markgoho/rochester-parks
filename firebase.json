{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": {
    "predeploy": [
      "npm --prefix \"$RESOURCE_DIR\" run lint",
      "npm --prefix \"$RESOURCE_DIR\" run build"
    ]
  },
  "hosting": {
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "/_app/immutable/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/rochester-city-parks/manhattan-square",
        "destination": "/rochester-city-parks/dr-martin-luther-king-jr-park-and-ice-rink/",
        "type": 301
      },
      {
        "source": "/town-parks/webster-parks/north-ponds-park",
        "destination": "/town-parks/webster-parks/charles-e-sexton-memorial-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/events",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/history",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/photos",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/reservations",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/reviews",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/monroe-county-parks/webster-park/trails",
        "destination": "/monroe-county-parks/webster-park/",
        "type": 301
      },
      {
        "source": "/rochester-city-parks/ellwanger-and-barry-park/history",
        "destination": "/rochester-city-parks/ellwanger-and-barry-park/#history",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/events",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/history",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/photos",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/reservations",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/reviews",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/brighton-parks/persimmon-park/trails",
        "destination": "/town-parks/brighton-parks/persimmon-park/",
        "type": 301
      },
      {
        "source": "/town-parks/greece-parks/veterans-memorial-park/history",
        "destination": "/town-parks/greece-parks/veterans-memorial-park/",
        "type": 301
      },
      {
        "source": "/town-parks/greece-parks/veterans-memorial-park/trails",
        "destination": "/town-parks/greece-parks/veterans-memorial-park/",
        "type": 301
      },
      {
        "source": "/about-rochester-parks",
